{
  "name": "paperwild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.ts",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:online:live": "node --test tests/integration/online-live.test.ts",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "convex": "1.47.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "convex-test": "^0.0.63",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
